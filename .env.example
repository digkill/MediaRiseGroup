# Публичный URL (без слеша в конце) — metadata, Open Graph, JSON-LD.
# Задайте при `yarn build` на CI/сервере, чтобы канонические URL совпадали с продом.
SITE_URL=https://mediarise.org

# Адрес и порт процесса Next за reverse proxy (nginx).
LISTEN_HOST=127.0.0.1
PORT=3000

# Optional local Laravel API. Production sets this to its internal gateway.
# Leave empty only for a read-only preview using the English seed catalogue.
PORTFOLIO_API_URL=http://127.0.0.1:8001
