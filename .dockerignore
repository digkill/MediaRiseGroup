# Build artefacts and deps — reinstalled/rebuilt inside the image
node_modules
.next
out
build
dist
*.tsbuildinfo

# Development-only backend files
backend/vendor
backend/node_modules
backend/.env
backend/.env.*
backend/storage/logs/*
backend/storage/framework/*
backend/bootstrap/cache/*.php
backend/tests
backend/database/*.sqlite
scripts/start.mjs

# VCS and tooling
.git
.gitignore
.github
.vscode
.idea
.claude
.codex
.cursor

# Secrets — SITE_URL is passed as a build arg instead
.env
.env.*
!.env.example

# Noise
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
README.md

# Keep local account credentials and test artefacts out of images
.private
